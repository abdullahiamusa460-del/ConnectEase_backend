# ---------------------------------------------------------------------------
# ConnectEase API — example environment
# Copy to .env and replace every placeholder before running the server.
# Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string. Use SSL in production.
DATABASE_URL=postgres://connectease:change-me@localhost:5432/connectease
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Comma-separated list of browser origins allowed to call the API.
# Use * only when you intentionally want any origin to call a public deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Number of reverse proxies in front of Express (0 when running directly).
TRUST_PROXY=0

# Server-side pepper used to hash anonymous installation secrets.
# Generate one with: openssl rand -hex 32
# This value must stay private. Rotating it invalidates existing installations.
INSTALLATION_PEPPER=replace-with-at-least-32-random-characters

# Rate limits (all values are milliseconds unless stated otherwise)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
WRITE_RATE_LIMIT_MAX=120
SYNC_RATE_LIMIT_MAX=60
REGISTRATION_RATE_LIMIT_MAX=20
